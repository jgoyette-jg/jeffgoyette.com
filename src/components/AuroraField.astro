---
/**
 * The animated gradient field behind the hero.
 *
 * Four soft radial blobs on a fixed layer, drifting on long offset cycles.
 * Three decisions are load-bearing:
 *
 *   1. No `filter: blur()`. An earlier version blurred each blob by ~90px;
 *      profiling showed it was redundant, because a radial-gradient fading to
 *      transparent is already soft. The falloff now lives in the gradient stops,
 *      which cost nothing to rasterise.
 *   2. Nothing animates a property outside transform and opacity, so the drift
 *      stays entirely on the compositor and the page can reach idle.
 *   3. The layer is `position: fixed` with `pointer-events: none` and lives
 *      behind everything at z-index -1. It never participates in layout, so it
 *      cannot shift content or create a scroll container.
 *
 * Pointer parallax is added by a script that writes two custom properties. If
 * the script never runs the blobs still drift; the parallax is additive.
 */

interface Props {
  /** Dial the whole field down on interior pages, where it must not compete
   *  with body text. 1 is the hero, 0.45 is about right for a résumé. */
  intensity?: number;
}

const { intensity = 1 } = Astro.props;
---

<div class="aurora" style={`--intensity: ${intensity}`} aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
  <span class="blob b4"></span>
  <span class="veil"></span>
</div>

<script>
  /**
   * Feed pointer position to the aurora layer as two normalised offsets.
   *
   * Written inside a rAF tick rather than directly in the listener:
   * `pointermove` fires faster than the frame rate, and every write to a custom
   * property invalidates style for each blob that reads it. Coalescing to one
   * write per frame keeps that at four recalcs per frame instead of a dozen.
   */
  const field = document.querySelector<HTMLElement>('.aurora');

  if (field && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let px = 0;
    let py = 0;
    let queued = false;

    const flush = () => {
      queued = false;
      field.style.setProperty('--px', px.toFixed(4));
      field.style.setProperty('--py', py.toFixed(4));
    };

    // Coarse pointers have no hover position to track, and the listener would
    // only fire on tap — so the parallax is desktop-only by capability check
    // rather than by viewport width.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      addEventListener(
        'pointermove',
        (event) => {
          // -0.5..0.5 so the rest position is genuinely centred.
          px = event.clientX / innerWidth - 0.5;
          py = event.clientY / innerHeight - 0.5;
          if (!queued) {
            queued = true;
            requestAnimationFrame(flush);
          }
        },
        { passive: true }
      );
    }
  }
</script>

<style>
  .aurora {
    --px: 0;
    --py: 0;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Promotes the whole field to its own layer once, rather than letting each
       blob promote itself and then compositing five surfaces. */
    contain: strict;
  }

  .blob {
    position: absolute;
    inline-size: 46vmax;
    block-size: 46vmax;
    border-radius: 50%;
    opacity: calc(0.42 * var(--intensity));
    /* No `filter: blur()` and no `will-change`, both deliberate.

       The blur here was ~90px applied over 1.15 million px², and measurement
       showed it bought nothing: a radial-gradient that fades to transparent is
       already soft, so blurring it just re-rasterised an enormous surface to
       reach almost the same image. Removing it changed the look imperceptibly
       and freed the GPU. Softening the gradient's own falloff is free.

       `will-change: transform` was pinning four large layers into GPU memory
       permanently (~28MB at 2x DPR). A running transform animation promotes
       its element anyway, so the hint was paying rent for nothing. */
  }

  /* Parallax depth: each blob shifts by a different multiple of the pointer
     offset, which is what reads as depth rather than as one moving image. */
  .b1 {
    inset-block-start: -14vmax;
    inset-inline-start: -8vmax;
    background: radial-gradient(circle at 50% 50%, var(--signal) 0%, color-mix(in oklch, var(--signal) 45%, transparent) 38%, transparent 72%);
    animation: drift-a 26s ease-in-out infinite;
    translate: calc(var(--px) * 44px) calc(var(--py) * 44px);
  }

  .b2 {
    inset-block-start: -6vmax;
    inset-inline-end: -12vmax;
    background: radial-gradient(circle at 50% 50%, var(--dom-telecom-2) 0%, color-mix(in oklch, var(--dom-telecom-2) 45%, transparent) 38%, transparent 72%);
    animation: drift-b 32s ease-in-out infinite;
    translate: calc(var(--px) * -30px) calc(var(--py) * 26px);
  }

  .b3 {
    inset-block-start: 34vmax;
    inset-inline-start: 22vmax;
    background: radial-gradient(circle at 50% 50%, var(--dom-commerce-2) 0%, color-mix(in oklch, var(--dom-commerce-2) 45%, transparent) 36%, transparent 70%);
    opacity: calc(0.26 * var(--intensity));
    animation: drift-c 38s ease-in-out infinite;
    translate: calc(var(--px) * 62px) calc(var(--py) * -18px);
  }

  .b4 {
    inset-block-start: 12vmax;
    inset-inline-start: 38vmax;
    inline-size: 30vmax;
    block-size: 30vmax;
    background: radial-gradient(circle at 50% 50%, var(--dom-ai-2) 0%, color-mix(in oklch, var(--dom-ai-2) 45%, transparent) 40%, transparent 74%);
    opacity: calc(0.3 * var(--intensity));
    animation: drift-b 29s ease-in-out infinite reverse;
    translate: calc(var(--px) * -52px) calc(var(--py) * 40px);
  }

  /* Blurred saturated colour behind body copy fails contrast. The veil pulls
     the field back toward paper so text sits at full contrast while the colour
     still reads at the edges. */
  .veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 30%, transparent, var(--paper) 78%),
      linear-gradient(to bottom, transparent 40%, var(--paper) 92%);
  }

  /* Translation only — no `scale()`, and that is the point.

     A composited layer can be moved by the compositor for free, because the
     rasterised texture is still valid at the new position. Scaling invalidates
     it: the gradient has to be re-rasterised at the new size every frame, and
     these layers are ~400k px² each. Dropping scale from these three keyframes
     was worth roughly 10ms per idle frame on a slow machine.

     Distances are larger than the old ones to keep the motion legible now that
     the size no longer changes. Opacity is deliberately not animated here: each
     blob sets its own base opacity, and an absolute value in a shared keyframe
     would flatten all four to the same one.

     `translate` is set inline above and these drive `transform`, so the two
     compose rather than overwrite. That is the whole reason the parallax uses
     the newer individual property. */
  @keyframes drift-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(9vmax, 6vmax, 0);
    }
  }

  @keyframes drift-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-10vmax, 7vmax, 0);
    }
  }

  @keyframes drift-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(8vmax, -9vmax, 0);
    }
  }

  /* Drift is atmosphere. The field itself is not — removing it entirely would
     change the page's colour, so the blobs stay and only the motion stops. */
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>
