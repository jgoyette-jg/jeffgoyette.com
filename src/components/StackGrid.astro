---
/**
 * The capability grid: filter chips, a live text filter, and a running count.
 *
 * Built as a custom element rather than a framework island. The markup below is
 * the complete, working content — every card and chip is in the HTML. The
 * element only adds hiding and counting on top. That means the page is fully
 * readable and fully indexable before any script runs, and the interactivity
 * degrades to "everything visible", which is the correct failure mode for a
 * filter.
 */

import { skills } from '../data/site';

const total = skills.reduce((sum, group) => sum + group.items.length, 0);

/** Stable, URL- and attribute-safe key for a group name. */
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<stack-grid data-total={total}>
  <div class="controls">
    <div class="chips" role="group" aria-label="Filter by capability area">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">
        All
      </button>
      {
        skills.map((group) => (
          <button type="button" class="chip" data-filter={slug(group.group)} aria-pressed="false">
            {group.group}
            <span class="tally mono">{group.items.length}</span>
          </button>
        ))
      }
    </div>

    <div class="search">
      <label class="mono" for="stack-q">Find</label>
      <input
        id="stack-q"
        type="search"
        placeholder="kafka, istio, c2pa…"
        autocomplete="off"
        spellcheck="false"
      />
      <p class="count mono" role="status" aria-live="polite">
        <span data-shown={total}>{total}</span> of {total}
      </p>
    </div>
  </div>

  <ul class="grid">
    {
      skills.map((group, i) => (
        <li
          class="card reveal spotlight"
          data-group={slug(group.group)}
          style={`--i: ${i}`}
        >
          <h3>{group.group}</h3>
          <p class="blurb">{group.blurb}</p>
          <ul class="items">
            {group.items.map((item) => (
              <li class="item mono" data-item={item.toLowerCase()}>
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <p class="none mono" hidden>Nothing matches that.</p>
</stack-grid>

<script>
  class StackGrid extends HTMLElement {
    connectedCallback() {
      const chips = [...this.querySelectorAll<HTMLButtonElement>('.chip')];
      const cards = [...this.querySelectorAll<HTMLElement>('.card')];
      const input = this.querySelector<HTMLInputElement>('input[type="search"]');
      const shown = this.querySelector<HTMLElement>('[data-shown]');
      const none = this.querySelector<HTMLElement>('.none');

      let group = 'all';
      let query = '';

      const apply = () => {
        let visible = 0;

        for (const card of cards) {
          const inGroup = group === 'all' || card.dataset.group === group;
          const items = [...card.querySelectorAll<HTMLElement>('.item')];

          let matches = 0;
          for (const item of items) {
            // Substring, not fuzzy: for a list of proper nouns an exact
            // substring is what people actually type, and fuzzy matching
            // would surface 'Kafka' for a query of 'java'.
            const hit = !query || (item.dataset.item ?? '').includes(query);
            item.hidden = !hit;
            if (hit) matches += 1;
          }

          // A card survives only if its group is selected AND it still has at
          // least one matching item — an empty card with a heading is worse
          // than no card.
          const keep = inGroup && matches > 0;
          card.hidden = !keep;
          if (keep) visible += matches;
        }

        if (shown) shown.textContent = String(visible);
        if (none) none.hidden = visible > 0;
      };

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          group = chip.dataset.filter ?? 'all';
          for (const other of chips) {
            other.setAttribute('aria-pressed', String(other === chip));
          }
          apply();
        });
      }

      if (input) {
        let timer: number | undefined;
        input.addEventListener('input', () => {
          // Debounced because `apply` touches every item node. Typing 'cassandra'
          // would otherwise run nine full passes over ~80 elements.
          clearTimeout(timer);
          timer = setTimeout(() => {
            query = input.value.trim().toLowerCase();
            apply();
          }, 110) as unknown as number;
        });
      }
    }
  }

  customElements.define('stack-grid', StackGrid);
</script>

<style>
  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block-end: var(--space-md);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }

  .chip:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  /* `aria-pressed` is the state, so it is also the selector. There is no
     parallel `.is-active` class to fall out of sync with it. */
  .chip[aria-pressed='true'] {
    color: var(--on-cta);
    background: var(--grad-cta);
    border-color: transparent;
    box-shadow: var(--glow-soft);
  }

  .tally {
    font-size: 0.66rem;
    opacity: 0.65;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .search label {
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.68rem;
  }

  input[type='search'] {
    flex: 1 1 12rem;
    max-inline-size: 20rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  input[type='search']:focus-visible {
    border-color: transparent;
    box-shadow: 0 0 0 2px var(--signal);
    outline: none;
  }

  .count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin-inline-start: auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1rem, 2.4vw, 1.35rem);
    background: var(--grad-surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .card:hover {
    border-color: color-mix(in oklch, var(--signal) 35%, var(--rule));
    box-shadow: var(--glow-lift);
    transform: translateY(-3px);
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .blurb {
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--muted);
    text-wrap: pretty;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    margin-block-start: auto;
    padding-block-start: 0.4rem;
  }

  .item {
    padding: 0.22rem 0.5rem;
    font-size: 0.7rem;
    color: var(--ink);
    background: var(--signal-wash);
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .item:hover {
    background: color-mix(in oklch, var(--signal) 22%, transparent);
  }

  .none {
    padding-block: var(--space-lg);
    color: var(--muted);
    text-align: center;
  }
</style>
