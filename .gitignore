# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Source résumés. Ignored by default because these usually carry a home
# address and phone number, and this repo is likely to end up public.
# Remove this line if you want them versioned — but check what's in them first.
# The published PDF at public/resume.pdf is NOT covered by this.
/resumes/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Agent and local dev notes. Kept on disk, out of the repo — this remote is
# public, and README.md in particular tells a reader to drop résumé documents
# into /resumes, which is ignored precisely because they carry a phone number.
CLAUDE.md
AGENTS.md
README.md
